# ============================================================
# Discord Bot – Konfiguration
# Datei kopieren: .env.example → .env  (nie committen!)
# ============================================================
#
# Laufzeit-Overrides: Das Settings-Panel des Servers pusht Bot-Variablen über
# den Control-Kanal an diesen Bot. Persistente Änderungen speichert der Bot in
# DATA_DIR/config.overrides.json und lädt sie beim Start (überschreiben die
# .env-Werte). Diese Datei bleibt die dokumentierte Basis.

# --- Pflichtfelder ---
DISCORD_TOKEN=dein-discord-bot-token-hier
# Ein oder mehrere Guild-IDs, kommasepariert (empfohlen für schnelle Propagation)
GUILD_IDS=123456789,987654321
# GUILD_ID=123456789   # Legacy-Fallback (einzelne ID)

# --- Server-Verbindung (optional, nur wenn apps/server läuft) ---
# Basis-URL des LAN-Servers (ws:// oder wss://)
SERVER_BASE_URL=ws://192.168.x.x:7440
# Muss mit CONTROL_BEARER im server/.env übereinstimmen
CONTROL_BEARER=

# --- Transkript-Live-Sync (optional) ---
# Der Server pusht jedes Transkript-Event (STT, LLM-Antwort, Wake-Word, ...)
# zusätzlich zu seiner eigenen (bei Cloud-Instanzen: ephemeren) Kopie live über
# die Control-WS an den Bot. Landet hier auf dem (persistenten) Bot-Host statt
# erst bei stop.sh/manuellem Pull von der Instanz geholt werden zu müssen.
# Default: ~/transcripts
# BOT_TRANSCRIPT_DIR=/home/discordbot/transcripts
# Alte Sessions werden automatisch aufgeräumt (täglich geprüft), Default 30 Tage.
BOT_TRANSCRIPT_RETENTION_DAYS=30

# --- Finalize-Archiv-Pull (optional) ---
# Direkt nach einem erfolgreichen Finalize zieht der Bot das FERTIGE Archiv
# (transcript.md, manifest.json, speaker-map.json, session.jsonl, audio/*) aktiv
# vom Server zurück auf den persistenten Bot-Host — sonst stirbt es mit der
# ephemeren Cloud-Instanz beim Auto-Stop (die Instanz darf per WireGuard nur zu
# Proxmox, nicht zum Bot, also zieht der Bot). Jede Datei wird per sha256 gegen
# das Server-Manifest verifiziert. stop.sh --backup bleibt nur noch das Notnetz.
# Default: ~/archive
# BOT_ARCHIVE_DIR=/home/discordbot/archive
# Alte Archive werden automatisch aufgeräumt (täglich geprüft), Default 60 Tage.
BOT_ARCHIVE_RETENTION_DAYS=60

# --- Server-Auto-Start (optional) ---
# Beim /join prüft der Bot per TCP-Probe ob der Server erreichbar ist.
# Falls nicht und SERVER_START_CMD gesetzt ist, wird dieses Kommando ausgeführt
# und auf SERVER_START_TIMEOUT_MS Erreichbarkeit gewartet (fire-and-forget —
# der Befehl muss selbst idempotent sein, der Bot ruft ihn bei jedem /join
# ohne erreichbaren Server erneut auf).
#
# Cloud-GPU (Verda), empfohlener Default — siehe deploy/README.md.
# Pfad = wo das Repo auf dem Bot-Host tatsächlich liegt (Beispiel unten
# passend zu /home/discordbot/discord-voice-assistant):
# SERVER_START_CMD=/home/discordbot/discord-voice-assistant/deploy/scripts/cloud-start.sh
#
# Lokaler Windows-Server (Legacy-Beispiel):
# SERVER_START_CMD=ssh -i ~/.ssh/id_ed25519_va -o BatchMode=yes -o StrictHostKeyChecking=accept-new nogar@192.168.20.101 "powershell -ExecutionPolicy Bypass -File C:\Users\nogar\Programme\discord-voice-assistant\scripts\Start-VoiceAssistant.ps1 -Mode silent"
SERVER_START_CMD=

# Wie lange (ms) nach SERVER_START_CMD auf Erreichbarkeit gewartet wird.
# Default 30000 (SSH/lokal) ist für einen Cloud-Kaltstart zu kurz (Instanz-
# Provisionierung + Startup-Script + Image-Pull dauerten bei uns ~3 Minuten) —
# bei Verda-Nutzung deutlich höher setzen.
SERVER_START_TIMEOUT_MS=300000

# Watchdog: falls die Verbindung während einer AKTIVEN Session (nach /join)
# länger als das hier offline bleibt, wird SERVER_START_CMD automatisch
# erneut ausgelöst — z.B. wenn eine Spot-Instanz mittendrin reklamiert wird.
# Der normale Reconnect-Loop versucht sonst für immer dieselbe (tote) Adresse.
SERVER_WATCHDOG_THRESHOLD_MS=90000
# Mindestabstand zwischen zwei automatischen Neustart-Versuchen, damit ein
# dauerhaftes Problem nicht die Cloud-API/den Bot mit Anfragen flutet.
SERVER_WATCHDOG_COOLDOWN_MS=300000

# --- Server-Auto-Stop (optional, Cloud-GPU) ---
# Gegenstück zum Auto-Start: fährt den Server nach einer Leerlaufzeit ohne
# aktive Session wieder herunter, damit ein Cloud-GPU-Server nicht unnötig
# Kosten verursacht. Nur aktiv, wenn SERVER_STOP_CMD gesetzt ist (leer = aus).
#
# Der Timer wird (neu) gestartet, sobald keine Session mehr aktiv ist (nach
# /leave, nach einem Finalize oder einer Text-Anfrage) und beim Ablauf nochmals
# geprüft: läuft dann wieder eine Session, wird NICHT gestoppt. Ein /join sowie
# der Beginn eines Finalize brechen einen anstehenden Stopp ab (dort wird der
# Server gebraucht). Das Kommando ist fire-and-forget und unabhängig von der
# Control-Verbindung (reiner lokaler Exec wie SERVER_START_CMD).
#
# ACHTUNG: Das Stop-Kommando ZERSTÖRT die Cloud-Instanz vollständig (die
# Verda-Abrechnung endet damit) — ein späterer /join provisioniert über
# SERVER_START_CMD eine neue Instanz.
#
# Cloud-GPU (Verda), empfohlener Default — siehe deploy/README.md:
# SERVER_STOP_CMD=/home/discordbot/discord-voice-assistant/deploy/scripts/cloud-stop.sh
SERVER_STOP_CMD=

# Leerlaufzeit (ms) ohne aktive Session, nach der SERVER_STOP_CMD ausgeführt
# wird. Default 900000 (15 Minuten).
SERVER_STOP_DELAY_MS=900000

# --- Datenspeicherung ---
# Verzeichnis für Session-Aufnahmen (WAV, OGG, JSON)
DATA_DIR=/opt/discord-recorder/data

# --- Session-Verwaltung ---
# Stunden bis eine inaktive Session automatisch beendet wird
SESSION_IDLE_HOURS=4
# Verlassene Sessions (/leave, Voice-Abbruch) nach SESSION_IDLE_HOURS automatisch
# finalisieren — auch nach Bot-Neustart. Startet den Server bei Bedarf per
# SERVER_START_CMD (Cloud: GPU-Instanz). false = nur manuell per /finalize run.
AUTO_FINALIZE_AFTER_LEAVE=true

# --- Finalize: Audio-Upload zum Server ---
# LEER (neuer Default): Die Session-WAVs + manifest.json werden per HTTP-Upload
# (PUT /finalize/upload/<sessionId>/<datei>) über die bestehende
# Server-Verbindung hochgeladen — Ziel = SERVER_BASE_URL, Auth = CONTROL_BEARER.
# Das ist der Cloud-Pfad (Instanz nur via WireGuard erreichbar, kein scp-Ziel):
# kein scp/SSH nötig. Ist WEDER FINALIZE_UPLOAD_CMD NOCH SERVER_BASE_URL
# gesetzt, wird der Upload übersprungen (Bot & Server teilen sich ein
# Dateisystem o.Ä.).
#
# GESETZT (Legacy-Override, LAN/Windows): Kommando-Template, das die WAVs selbst
# überträgt (scp/SSH). Platzhalter: {src} = lokales chunks-Verzeichnis,
# {sessionId} = Session-ID. Muss die WAVs (inkl. manifest.json) nach
# <Server-FINALIZE_UPLOAD_DIR>/<sessionId>/ legen.
# Beispiel (Windows-Server, OpenSSH):
# FINALIZE_UPLOAD_CMD=scp -i ~/.ssh/id_ed25519_va -o BatchMode=yes -r {src}/. nogar@192.168.20.101:C:/Users/nogar/Programme/discord-voice-assistant/apps/server/uploads/{sessionId}/
FINALIZE_UPLOAD_CMD=
# Was nach erfolgreichem (checksum-bestätigtem) Finalize mit den lokalen WAVs
# passiert: move (ins _archived/-Verzeichnis verschieben) oder delete.
ARCHIVE_RETENTION=move

# --- Finalize: Wartezeit auf den Server ---
# Der Bot wartet auf das Finalize-Ergebnis, solange Fortschritt kommt: jede
# Fortschrittsmeldung des Servers (x/N Äußerungen, Zusammenführen,
# Zusammenfassung, Audio — während eines Laufs mindestens einmal pro Minute)
# startet die Frist neu. Erst nach so langer Stille (Server hängt/abgestürzt,
# Verbindung bleibt weg) gibt der Bot auf; die Session bleibt offen und kann mit
# /finalize run erneut finalisiert werden. Default 10 min, mindestens 2 min.
FINALIZE_IDLE_TIMEOUT_MS=600000
# Obergrenze für die gesamte Wartezeit, auch bei laufendem Fortschritt (Netz
# gegen einen Lauf, der nie endet). Eine 3-h-Session braucht für
# Nach-Transkription + Zusammenfassung rund eine halbe Stunde (je nach GPU).
# Default 3 h, mindestens 10 min.
FINALIZE_MAX_MS=10800000

# --- TTS Playback / Unterbrechung ---
# Legacy: im neuen FIFO-TTS-Pfad derzeit ungenutzt
GATE_MS=80
# Legacy: im neuen FIFO-TTS-Pfad derzeit ungenutzt
PLAYOUT_MAX_MS=1500
# Mindest-Sprechdauer damit eine Unterbrechung zählt (ms)
INTERRUPT_MIN_MS=800
# Wartezeit nach Unterbrechung bevor Wiedergabe fortgesetzt wird (ms)
RESUME_GATE_MS=1200
# Wiederholung vor der Unterbrechungsstelle beim Fortsetzen (ms)
REWIND_MS=1000

# --- Debug ---
# 1 = ausführliches Logging aktivieren
DEBUG=0
