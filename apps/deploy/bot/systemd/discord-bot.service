[Unit]
Description=Discord Voice Assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/discordbot/discord-voice-assistant
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start:bot
Restart=always
RestartSec=3
User=discordbot

[Install]
WantedBy=multi-user.target
