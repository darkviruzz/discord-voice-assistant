# ============================================================
# Discord Voice Server – Konfiguration
# Datei kopieren: .env.example → .env  (nie committen!)
# ============================================================
#
# Schichtung zur Laufzeit:  .env (Defaults)  →  Override-Layer  →  temporär
# Das Settings-Panel der Transkript-UI (/transcript) kann fast alle Variablen
# unten zur Laufzeit ändern. Persistente Änderungen landen im Override-Layer
# (JSON), NICHT in dieser Datei — diese bleibt die dokumentierte Basis.

# --- Server ---
HOST=0.0.0.0
PORT=7440
# Ablageort des persistenten Override-Layers (Settings-Panel). Optional;
# Default: ./data/config.overrides.json
# CONFIG_OVERRIDES_FILE=./data/config.overrides.json
# Zufälliges Secret, muss mit CONTROL_BEARER im bot/.env übereinstimmen
CONTROL_BEARER=hier-langes-zufaelliges-secret-eintragen
SESSION_SECRET=
# 1 = ausführliches Logging
DEBUG=0

# --- Finalize-Pipeline ---
# Verzeichnis, in das der Bot die Session-WAVs hochlädt (pro Session ein
# Unterordner <sessionId>/ mit den WAVs + manifest.json).
FINALIZE_UPLOAD_DIR=./uploads
# Langzeit-Archiv (Transkript + Audio + JSONL + Manifest + Speaker-Map-Snapshot).
# Wird nach jedem erfolgreichen Finalize zusätzlich automatisch vom Bot auf den
# persistenten Bot-Host gezogen (siehe apps/bot/.env.example: BOT_ARCHIVE_DIR) —
# kein manueller scp/stop.sh-Pull mehr nötig, das bleibt nur noch das Notnetz.
ARCHIVE_DIR=./archive
# Persistente Speaker-Map (Discord-ID → Spieler/Charakter), pro Guild.
SPEAKER_MAP_FILE=./data/speaker-map.json
# Pausen-Schwellwert im Transkript (Sekunden) → "## HH:MM — Pause (N min)".
PAUSE_THRESHOLD_S=30
# Zeitzone für Transkript-Zeitstempel.
FINALIZE_TZ=Europe/Berlin
# Audio-Archiv: Per-Äußerung-Format. wav = Original-WAVs ins Archiv (verlustfreies
# Master + Quelle für Re-Finalize, Standard). ogg = stattdessen Opus encoden
# (kleiner, aber Re-Finalize aus dem Archiv erst möglich, wenn OGG→PCM-Decode da
# ist). Der gemergte session_mix.ogg wird unabhängig davon erzeugt (wenn ffmpeg da).
ARCHIVE_AUDIO_FORMAT=wav
ARCHIVE_OPUS_BITRATE=32k
# Transiente Upload-WAVs nach erfolgreichem Finalize auf dem Server behalten?
# false = nach Verifikation + Archivierung löschen (Standard; das Archiv hält die
# Originale).
FINALIZE_KEEP_UPLOADS=false
# Kurze Session-Zusammenfassung per LLM beim Finalize (summary.md im Archiv).
# Rabenauge nutzt sie auf Nachfrage („Was war letztes Mal?"), nie als Begrüßung.
SESSION_SUMMARY_ENABLED=true
SESSION_SUMMARY_MAX_CHARS=2500
SESSION_SUMMARY_CHUNK_CHARS=12000
# Zeitbudget (ms) für die gesamte Zusammenfassung — sie läuft im Finalize, auf
# dessen Ergebnis der Bot wartet (Bot: FINALIZE_MAX_MS, Standard 3 h).
# Aufgebraucht → Finalize ohne Zusammenfassung.
SESSION_SUMMARY_TIMEOUT_MS=600000
# Optional Kopie als Notiz in den Vault (Ordner relativ zu OBSIDIAN_VAULT_PATH).
# Leer = aus. Nicht im Docker-Stack (Vault dort read-only eingebunden).
# SESSION_SUMMARY_VAULT_DIR=Rabenauge/Sessions
# Mindestabstand (ms) der Fortschrittsmeldungen an den Bot (Discord-Statusnachricht).
FINALIZE_PROGRESS_MS=3000

# --- STT (Spracherkennung) ---
# Anbieter: whispercpp = whisper.cpp-Server, natives POST /inference auf
# WHISPER_URL (Standard). openai = beliebiger OpenAI-kompatibler Endpunkt
# POST <STT_BASE_URL>/audio/transcriptions — z. B. vLLM (Whisper, Voxtral),
# AMD Lemonade, Speaches oder whisper.cpp mit
# --inference-path /v1/audio/transcriptions.
STT_PROVIDER=whispercpp
# Nur bei STT_PROVIDER=openai: Basis-URL inkl. /v1, Modellname (leer = Feld
# weglassen → Server-Default) und optionaler Bearer-Key.
# STT_BASE_URL=http://localhost:8000/v1
# STT_MODEL=openai/whisper-large-v3
# STT_API_KEY=
# Max. Dauer einer STT-Anfrage inkl. Upload + Antwort (ms, beide Anbieter;
# 0 = kein Timeout).
STT_TIMEOUT_MS=120000
# whisper.cpp-Server, gestartet via scripts/Start-VoiceAssistant.ps1 (Port 8080)
WHISPER_URL=http://localhost:8080
# Sprachcode: de | en | auto (lesen auch die Startskripte für whisper.cpp)
WHISPER_LANGUAGE=de
# Anbieterneutrale Sprache; leer = WHISPER_LANGUAGE.
# STT_LANGUAGE=de
# Sampling-Temperature (beide Anbieter; T>0 liefert deutlich bessere
# no_speech_prob-Werte; 0.1 ist ein konservativer Default, getestet auf de_DE-Audio).
WHISPER_TEMPERATURE=0.1
# no_speech_prob wird im Live-Pfad gespeichert, aber nicht verworfen.
# Optionaler Zukunftswert für Finalize/offline-Filtertests:
# WHISPER_NO_SPEECH_THRESHOLD=0.67
# Maximale Länge eines STT-Chunks bevor an Stille gesplittet oder erzwungen geteilt wird
# (nur noch Fallback-/Finalize-Pfad — der Live-Pfad streamt ohne Chunk-Grenzen)
STT_MAX_CHUNK_SECONDS=30
# Streaming-Transkription (LocalAgreement): das wachsende Audio-Fenster wird
# laufend als Ganzes transkribiert; stabile Wörter erscheinen sofort, der
# Satzrest als korrigierbare Vorschau. true=an (Standard).
STT_STREAMING=true
# Tick-Intervall des Streaming-Loops in ms (Neustart nötig).
STT_STREAM_INTERVAL_MS=1000
# Mindest-Audio (ms) bevor der Streamer zum ersten Mal transkribiert.
STT_STREAM_MIN_WINDOW_MS=1000
# Fenster-Trim: decken die bestätigten Wörter so viele Sekunden ab, wird an der
# letzten bestätigten Satzgrenze fixiert (begrenzt GPU-Last pro Tick).
STT_STREAM_TRIM_SECONDS=15
# Fixierten Text als Whisper-Decoder-Prompt mitgeben (Konsistenz über die
# Fenstergrenze hinweg).
STT_STREAM_PROMPT=true
# Namen-Vokabular: Eigennamen der Kampagne, die Whisper bei JEDER Transkription
# (Live, Chunk-Fallback, Finalize) als Prompt vorangestellt bekommt, damit sie
# richtig geschrieben erkannt werden. Kommagetrennt; Reihenfolge = Priorität,
# höchstens 250 Zeichen gehen in den Prompt (Rest: Warnung im Log). Lange Listen
# erhöhen das Risiko halluzinierter Namen in Stille — mit npm run bench:stt messen.
# STT_VOCABULARY=Gaglath Matho, Rhogar Tonitruvales, Uhtred Ragnason, Greyhawk
# Dieselbe Liste als Datei (absolut oder relativ zu OBSIDIAN_VAULT_PATH; ein oder
# mehrere Namen pro Zeile, # = Kommentar). Kandidaten aus dem Vault: npm run vocab:stt
# STT_VOCABULARY_FILE=STT-Vokabular.md
# Wort-/Token-Zeitstempel von Whisper anfordern (für wortgenaues Interrupt-Splitting
# im Finalize). true=anfordern (wird ignoriert wenn der Server es nicht kann).
WHISPER_WORD_TIMESTAMPS=true
# RMS-Schwellwert für Silence-Detection beim Splitten langer Utterances
STT_SILENCE_THRESH=300

# --- LLM ---
# ollama = natives Ollama-API (Standard, mit Keep-Warm). openai = beliebiger
# OpenAI-kompatibler Server (/chat/completions): vLLM, AMD Lemonade, llama.cpp-
# Server, LM Studio … — dann LLM_BASE_URL (inkl. /v1) + LLM_MODEL setzen.
LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=
# LLM_API_KEY=
# Maximale Dauer einer Antwort-Anfrage (ms).
LLM_TIMEOUT_MS=120000
# Denkphase von Reasoning-Modellen (gemma4, qwen3, deepseek-r1 …), Ollama-Feld
# think: false = direkt antworten (Standard; mit Denkphase brauchte gemma4:12b
# ~50 s statt ~1 s pro Antwort), true = denken, low/medium/high = Stufe
# (gpt-oss), auto = Feld weglassen (Modell-Standard).
LLM_THINK=false
# Nur LLM_PROVIDER=openai, nur gesendet wenn gesetzt (ein strikter Server lehnt
# unbekannte Felder ab): reasoning_effort (z. B. none/minimal/low) bzw.
# chat_template_kwargs als JSON-Objekt (vLLM, llama.cpp-Server, SGLang).
# LLM_REASONING_EFFORT=none
# LLM_CHAT_TEMPLATE_KWARGS={"enable_thinking":false}
# Ollama läuft als Windows-Dienst (immer verfügbar)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Pfad zur System-Prompt-Datei (relativ zum apps/server Verzeichnis)
SYSTEM_PROMPT_FILE=./prompt.txt
# Anzahl der Gesprächsrunden die im Kontext gehalten werden
HISTORY_TURNS=6
# Antworten auf SPRACH-Anfragen (und Stop-Hinweise) zusätzlich in den Discord-
# Textkanal schreiben? Standard false = nur Sprachausgabe + Transkript. Getippte
# Fragen (/ask, /recap, @Erwähnung) werden immer im Kanal beantwortet.
DISCORD_POST_REPLIES=false
# Wie lange Ollama das Modell nach einer Anfrage im VRAM hält (-1 = dauerhaft).
OLLAMA_KEEP_ALIVE=30m
# Intervall (ms) der Keep-Warm-Pings solange der Bot im Voice-Channel ist
# (0 = keine periodischen Pings; keep_alive jeder echten Query wirkt weiter).
OLLAMA_KEEP_WARM_INTERVAL_MS=240000

# --- Live-Kontext & Kampagnen-Kontext ---
# Live-Transkript (alle Sprecher) + rollende Zusammenfassung + statischer
# Kampagnen-Kontext werden dem LLM als system-Blöcke mitgegeben. false = altes
# Verhalten (nur HISTORY_TURNS-Verlauf).
LIVE_CONTEXT_ENABLED=true
# Zielgröße des rohen Live-Puffers (Zeichen); Überlauf → ältere Turns falten.
LIVE_RAW_WINDOW_CHARS=6000
# Zeichen pro Faltung (vom ältesten Ende) in die Zusammenfassung.
LIVE_FOLD_CHARS=3000
# Obergrenze, wie viele Zeichen das Live-Transkript im Prompt belegt.
LIVE_RENDER_MAX_CHARS=6000
# Mindestabstand zwischen zwei Faltungen in ms (0 = keine Drosselung).
LIVE_FOLD_MIN_INTERVAL_MS=0
# Separates Modell für die rollende Zusammenfassung und die Session-Zusammen-
# fassung beim Finalize (leer = Antwort-Modell: OLLAMA_MODEL bzw. LLM_MODEL).
# SUMMARY_MODEL=
# Optional eigener Server für beide Zusammenfassungen (leer = wie die Antworten):
# SUMMARY_PROVIDER ollama|openai (leer = LLM_PROVIDER), SUMMARY_BASE_URL (bei
# openai inkl. /v1; leer = OLLAMA_URL bzw. LLM_BASE_URL), SUMMARY_API_KEY (leer =
# LLM_API_KEY, aber nur für denselben Server). Bei abweichendem Anbieter auch
# SUMMARY_MODEL setzen. URL und Key nur hier, nicht im Panel änderbar.
# SUMMARY_PROVIDER=openai
# SUMMARY_BASE_URL=http://localhost:8000/v1
# SUMMARY_API_KEY=
# Maximale Länge der rollenden Zusammenfassung (Zeichen).
SUMMARY_MAX_CHARS=2000
# Obsidian-Vault-Wurzel: Wissensbasis der RAG-Vault-Suche (s. u.) und Basis für
# ein relatives CAMPAIGN_CONTEXT_FILE.
# OBSIDIAN_VAULT_PATH=/pfad/zum/vault
# Datei mit dem statischen Kampagnen-Kontext (Variante A — Fallback, wenn RAG
# aus ist oder nichts liefert). Absoluter Pfad oder relativ zu OBSIDIAN_VAULT_PATH.
# Relativ ohne Vault → Datei-Fallback deaktiviert.
CAMPAIGN_CONTEXT_FILE=CAMPAIGN.md
# Obergrenze der Zeichen des Kampagnen-Kontexts (vom Anfang der Datei); gilt
# auch für die RAG-Treffer pro Anfrage.
CAMPAIGN_CONTEXT_MAX_CHARS=6000

# --- RAG: semantische Vault-Suche (läuft im Server, apps/server/src/rag/) ---
# true = der Server indexiert OBSIDIAN_VAULT_PATH im Hintergrund und liefert pro
# Wake-Word-Query die passendsten Vault-Abschnitte statt CAMPAIGN.md statisch zu
# lesen (Fallback auf CAMPAIGN.md, solange der Index nicht steht oder die
# Embeddings ausfallen). Ohne OBSIDIAN_VAULT_PATH ist RAG immer aus.
RAG_ENABLED=true
# Zeitbudget (ms) pro RAG-Abfrage (Embedding der Frage + Suche); danach degradiert
# die Pipeline auf den Datei-Fallback, statt zu blockieren.
RAG_TIMEOUT_MS=800
# Treffer-Filter: maximale Cosine-Distanz (1 − Cosinus-Ähnlichkeit; 0 = identisch,
# 1 = ohne Bezug, 2 = gegensätzlich). Treffer darüber werden verworfen, bevor sie
# in den LLM-Kontext gehen. Leer = kein Filter (alle Top-K-Treffer). Mit
# nomic-embed-text liegen gute Treffer meist bei ~0.2–0.45; DEBUG=1 loggt die
# Distanzen jeder Abfrage. Beispiel: 0.5
# RAG_SCORE_THRESHOLD=0.5
# Max. Zeichen pro Vault-Abschnitt (Notizen werden an ##-Überschriften geteilt,
# lange Abschnitte zusätzlich). Änderung → jede Notiz wird einmal neu eingebettet.
RAG_MAX_CHUNK_CHARS=2000
# Speicherort des Vektor-Index (index.bin; relativ zu apps/server). Übersteht
# Neustarts, unveränderte Notizen werden nicht neu eingebettet; Löschen ist
# gefahrlos (Neuaufbau aus dem Vault).
RAG_INDEX_DIR=./data/rag
# Zusätzlich zum Datei-Watcher: kompletter Vault-Abgleich alle N ms (0 = aus).
RAG_RESCAN_INTERVAL_MS=300000
# Embeddings: ollama (Standard, /api/embed auf OLLAMA_URL) oder openai (beliebiger
# OpenAI-kompatibler /embeddings-Endpunkt: vLLM, llama.cpp-Server, LM Studio …).
# Modell- oder Anbieterwechsel → der Index wird verworfen und neu aufgebaut.
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
# Nur bei EMBED_PROVIDER=openai: Basis-URL inkl. /v1 und optionaler API-Key.
# EMBED_BASE_URL=http://localhost:8000/v1
# EMBED_API_KEY=
# Wie lange Ollama das Embedding-Modell geladen hält (-1 = dauerhaft).
EMBED_KEEP_ALIVE=30m
# Task-Präfixe; leer/auskommentiert = automatisch (nomic: "search_query: " /
# "search_document: "), " " (in Anführungszeichen) = kein Präfix.
# EMBED_QUERY_PREFIX="search_query: "
# EMBED_DOC_PREFIX="search_document: "
# Zusammenfassung der zuletzt finalisierten Session (summary.md) als Kontext bei
# jeder Anfrage — Grundlage für „Was war letztes Mal?" bzw. /recap. Nur auf
# Nachfrage, keine Begrüßung beim /join.
LAST_SESSION_CONTEXT_ENABLED=true
LAST_SESSION_CONTEXT_MAX_CHARS=2500

# --- TTS ---
# Anbieter: piper (lokal, Standard) | openai (OpenAI-kompatibler /audio/speech-
# Endpunkt) | elevenlabs (Cloud). Wird pro Antwort gelesen — Umschalten im
# Settings-Panel greift sofort.
TTS_PROVIDER=piper
# Gilt für alle Anbieter: max. Wartezeit (ms) auf die Antwort des TTS-Servers
# und zwischen zwei Audio-Paketen — ein mitten im Satz hängender Server beendet
# die Wiedergabe mit Fehler statt ewig zu blockieren. Begrenzt nicht die
# Gesamtdauer eines langen Satzes. 0 = kein Timeout.
TTS_TIMEOUT_MS=30000

# --- TTS: Piper (lokal) ---
# Gestartet via scripts/Start-VoiceAssistant.ps1 (Port 5000)
TTS_URL=http://localhost:5000
# Speaker IDs (de_DE-thorsten_emotional) — Stimmung/Modell aus der LLM-Antwort
# wirken nur bei piper:
#   0=Fröhlich  1=Wütend  2=Angewidert  3=Betrunken
#   4=Neutral   5=Schläfrig  6=Überrascht  7=Flüsternd

# --- TTS: OpenAI-kompatibel (vLLM-Omni/Qwen3-TTS, AMD Lemonade/Kokoro, Speaches, OpenAI) ---
# TTS_PROVIDER=openai
# Basis-URL inkl. /v1; angefragt wird <URL>/audio/speech. Pflicht bei openai.
# TTS_BASE_URL=http://localhost:8000/v1
# Modell- und Stimmen-Name laut Server (/v1/models bzw. Server-Doku). Leer =
# Feld weglassen, der Server nimmt seinen Standard.
# TTS_MODEL=
# TTS_VOICE=
# Optional (Bearer); lokale Server brauchen meist keinen.
# TTS_API_KEY=
# pcm = rohes 16-Bit-Mono-PCM mit TTS_SAMPLE_RATE (OpenAI-Spezifikation: 24000).
# wav = Rate/Kanäle aus dem WAV-Header (Stereo → Mono) — robuster, wenn die
# PCM-Rate des Servers unklar ist. mp3/opus werden nicht unterstützt.
# TTS_RESPONSE_FORMAT=pcm
# TTS_SAMPLE_RATE=24000
# Sprechtempo 0.25–4.0 (1 = normal). Leer = Feld weglassen (Server-Standard).
# TTS_SPEED=1.0

# --- TTS: ElevenLabs (Cloud-Alternative) ---
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=dein-api-key
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Nur für regionalen Endpunkt / Proxy ändern (ohne /v1).
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# --- Wake Word ---
WAKE_WORD=Rabenauge
# Unscharfe Erkennung (Levenshtein-Distanz ≤ 2)
WAKE_WORD_FUZZY=true
# Maximale Wortposition im Satz (0 = überall, 3 = erste 3 Wörter)
WAKE_WORD_POSITION=3
# Kommagetrennte Stop-Phrasen; ohne Wakeword nur bei kurzen Äußerungen aktiv
STOP_PHRASES=stop,stopp,abbrechen,beenden,hör auf,aufhören,halt,halte an,halte ein
STOP_WITHOUT_WAKE_MAX_WORDS=5
