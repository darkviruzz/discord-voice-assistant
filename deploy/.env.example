# ============================================================================
# Cloud GPU deployment — Compose environment.
# Copy to deploy/.env (never commit) and adjust per instance.
#   cp deploy/.env.example deploy/.env
#
# Only the values Compose needs at `up` time live here. Full server tuning
# (wake word, live-context, finalize, etc.) goes into deploy/server.env — copy
# apps/server/.env.example there; it is loaded as an optional env_file.
# ============================================================================

# ── Images (portability) ────────────────────────────────────────────────────
# CI publishes version-pinned images to GHCR. Pin IMAGE_TAG to a released
# version (or a git SHA) so the exact image you validated on a cheap RTX 4090
# runs byte-identical on an A100/H100/H200 — no rebuild, no drift.
#   docker compose pull && docker compose up -d
REGISTRY=ghcr.io/darkviruzz/discord-voice-assistant
IMAGE_TAG=latest

# ── Network / exposure ──────────────────────────────────────────────────────
# Interface the Node server is published on. Point this at the instance's
# WireGuard/Tailscale IP so nothing is reachable from the public internet.
#   127.0.0.1  → host-local only (default, before the tunnel is up)
#   10.10.0.2  → WireGuard IP of the instance
#   0.0.0.0    → all interfaces (NOT recommended without a firewall)
SERVER_BIND=127.0.0.1
SERVER_PORT=7440

# Must match CONTROL_BEARER in the bot's .env. Generate a long random secret:
#   openssl rand -hex 32
CONTROL_BEARER=

# 1 = verbose server logging
DEBUG=0

# ── RAG (Phase 4) — semantic vault search (apps/rag) ────────────────────────
# Base URL of the Python RAG service. Set → the server does a semantic search
# per wake-word query instead of reading CAMPAIGN.md statically (falls back to
# the static file if the service is unreachable). Empty = RAG disabled.
RAG_URL=http://rag:5001
# Ollama embedding model used for indexing/querying — pulled into the ollama
# service by start.sh (alongside OLLAMA_MODEL below). Changing it makes the
# rag service drop its index and re-embed the whole vault on the next start.
RAG_EMBED_MODEL=nomic-embed-text
# How long ollama keeps the embedding model loaded after a RAG call (Ollama
# duration, e.g. 30m; -1 = forever; empty = Ollama's 5m default). Keeps the
# first query after a pause from paying a cold model load.
RAG_EMBED_KEEP_ALIVE=30m
# Timeout (ms) per RAG query; the pipeline silently degrades to the static
# file fallback after this instead of blocking.
RAG_TIMEOUT_MS=800
# Session briefing on /join: the session's own rolling summary — rebuilt from
# its JSONL log at session start, so in practice this fires when RESUMING a
# session that already has one — is used as a RAG query and the hits are
# injected as vault context. Only effective when RAG_URL is set.
RAG_BRIEFING_ENABLED=true
# Number of vault chunks used for the briefing.
RAG_BRIEFING_TOP_K=3
# Also post the briefing as a short Discord chat message in the join channel.
# false = inject as LLM context only, no chat spam.
RAG_BRIEFING_POST_CHAT=false
# Max cosine distance (0-2) a /query result may have to be kept; empty = no
# filter.
RAG_SCORE_THRESHOLD=

# ── Models ──────────────────────────────────────────────────────────────────
# whisper.cpp model file (lives on the whisper-models volume; start.sh fetches
# it on first run). Quantised medium is a good RTX-4090 default.
WHISPER_MODEL_FILE=ggml-medium-q5_0.bin
WHISPER_LANGUAGE=de
# whisper.cpp git ref for the build-from-source image.
WHISPER_CPP_REF=master

# ── STT provider ────────────────────────────────────────────────────────────
# whispercpp = the bundled `whisper` service (WHISPER_URL is fixed to it in
# docker-compose.yml). openai = any OpenAI-compatible /audio/transcriptions
# server instead — vLLM (Whisper, Voxtral), AMD Lemonade, Speaches, ... —
# reached at STT_BASE_URL (incl. /v1). The `whisper` service still starts but
# then sits idle. Set these HERE, not in server.env: compose passes them via
# `environment:`, which wins over env_file.
STT_PROVIDER=whispercpp
STT_BASE_URL=
# Model name sent as `model` (empty = omit, server picks its default/loaded one).
STT_MODEL=
# Optional bearer token for that server (local servers usually need none).
STT_API_KEY=
# Provider-neutral language; empty = WHISPER_LANGUAGE above.
STT_LANGUAGE=
# Max duration of one STT request incl. upload and reply (ms; 0 = no timeout).
STT_TIMEOUT_MS=120000

# Ollama model pulled on first start (see start.sh / README).
OLLAMA_MODEL=llama3.2
OLLAMA_KEEP_ALIVE=30m

# TTS provider: piper (local CUDA container, default) | openai (any
# OpenAI-compatible /audio/speech server: vLLM-Omni/Qwen3-TTS, AMD
# Lemonade/Kokoro, Speaches, OpenAI) | elevenlabs (key/voice via server.env).
# The TTS_* keys below are passed into the server container by
# docker-compose.yml and therefore WIN over the same keys in server.env — set
# them here. apps/server/.env.example explains each one.
TTS_PROVIDER=piper
PIPER_USE_CUDA=1
# All providers: max wait (ms) for the reply headers and between two audio
# chunks; a stalled stream ends with an error instead of hanging. 0 = off.
TTS_TIMEOUT_MS=30000
# openai only: base URL incl. /v1, reachable from inside the server container
# (a compose service name or the host's IP — not localhost); model/voice as
# the server names them (empty = server default); optional bearer key.
TTS_BASE_URL=
TTS_MODEL=
TTS_VOICE=
TTS_API_KEY=
# pcm = raw 16-bit mono at TTS_SAMPLE_RATE (OpenAI spec: 24000); wav = rate
# and channels from the WAV header. Empty TTS_SPEED = server default.
TTS_RESPONSE_FORMAT=pcm
TTS_SAMPLE_RATE=24000
TTS_SPEED=

FINALIZE_TZ=Europe/Berlin

# ── Data source / sink (local or cloud, via rclone) ─────────────────────────
# Both are OPTIONAL. Leave empty for a pure-local deployment (desktop): the
# server then reads campaign data from / writes outputs to the local volumes,
# and on the desktop your OneDrive/Nextcloud sync client handles the cloud copy.
#
# On an ephemeral cloud instance, set these so start.sh pulls campaign data in
# and stop.sh pushes finished transcripts/archive out — nothing persists on the
# instance. Works with any rclone remote (Nextcloud = WebDAV, OneDrive, S3, …).
#
# Set up the remotes once and point RCLONE_CONFIG at the resulting file:
#   rclone config            # create remotes named e.g. "nextcloud" / "onedrive"
#   cp ~/.config/rclone/rclone.conf deploy/rclone.conf
RCLONE_CONFIG=./rclone.conf
# Campaign input (pulled on start). e.g. nextcloud:DnD/Campaign
CAMPAIGN_REMOTE=
# The campaign file inside that folder (server reads OBSIDIAN_VAULT_PATH/<this>).
CAMPAIGN_CONTEXT_FILE=CAMPAIGN.md
# Finished data (pushed on stop). e.g. nextcloud:DnD/Sessions
OUTPUT_REMOTE=

# ── GPU assignment (documentation-driven; per-service CUDA_VISIBLE_DEVICES) ──
# GPU_TYPE is a documentation variable only — it does not switch any behaviour.
#
# Phase 1 — RTX 4090 (24 GB): everything on GPU 0.
#   GPU_TYPE=rtx4090
#   WHISPER_VISIBLE_DEVICES=0
#   OLLAMA_VISIBLE_DEVICES=0
#   PIPER_VISIBLE_DEVICES=0
#
# Phase 2 — 2x A100 80GB: 120B model sharded across both GPUs for Ollama,
# the lighter services on GPU 0.
#   GPU_TYPE=a100x2
#   OLLAMA_VISIBLE_DEVICES=0,1
#   WHISPER_VISIBLE_DEVICES=0
#   PIPER_VISIBLE_DEVICES=0
#
# Phase 3 — H200 141GB: single GPU, less sharding.
#   GPU_TYPE=h200
#   OLLAMA_VISIBLE_DEVICES=0
#   WHISPER_VISIBLE_DEVICES=0
#   PIPER_VISIBLE_DEVICES=0
GPU_TYPE=rtx4090
WHISPER_VISIBLE_DEVICES=0
OLLAMA_VISIBLE_DEVICES=0
PIPER_VISIBLE_DEVICES=0
